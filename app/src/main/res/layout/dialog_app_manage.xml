<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="230dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_glass_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="20dp"
    android:paddingEnd="18dp"
    android:paddingBottom="18dp">

    <!-- Minimal App Name Header -->
    <TextView
        android:id="@+id/dialog_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F1F5F9"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Action Buttons without icons -->
    <TextView
        android:id="@+id/btn_action_move"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/btn_dialog_selector"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:text="Move"
        android:textColor="@color/btn_dialog_text_color"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_action_fav"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/btn_dialog_selector"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:text="Unfavorite"
        android:textColor="@color/btn_dialog_text_color"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_action_info"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/btn_dialog_selector"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:text="Detail"
        android:textColor="@color/btn_dialog_text_color"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_action_uninstall"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/btn_dialog_selector"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:text="Uninstall"
        android:textColor="@color/btn_dialog_danger_text_color"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
