<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_glass_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Settings"
        android:textColor="#F1F5F9"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Toggle OLED Mode -->
    <TextView
        android:id="@+id/btn_setting_oled"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/btn_dialog_selector"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:text="OLED Pure Black: OFF"
        android:textColor="@color/btn_dialog_text_color"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Audio-Only Screen Off -->
    <TextView
        android:id="@+id/btn_setting_screen_off"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/btn_dialog_selector"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:text="Turn Off Screen (Audio Mode)"
        android:textColor="@color/btn_dialog_text_color"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Manage Hidden Apps -->
    <TextView
        android:id="@+id/btn_setting_hidden"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/btn_dialog_selector"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:text="Manage Hidden Apps"
        android:textColor="@color/btn_dialog_text_color"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- TV System Settings -->
    <TextView
        android:id="@+id/btn_setting_system"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/btn_dialog_selector"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:text="TV System Settings"
        android:textColor="@color/btn_dialog_text_color"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
