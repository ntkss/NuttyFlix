<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_container"
    android:layout_width="136dp"
    android:layout_height="76dp"
    android:layout_margin="4dp"
    android:background="@drawable/flauncher_card_selector"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- 16:9 Leanback Banner -->
    <ImageView
        android:id="@+id/app_banner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <!-- Fallback Content (Icon + Label side-by-side) -->
    <LinearLayout
        android:id="@+id/card_fallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Focus Outline Overlay -->
    <View
        android:id="@+id/card_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/flauncher_border_focused"
        android:visibility="gone" />

</FrameLayout>
